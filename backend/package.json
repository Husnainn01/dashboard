{
  "name": "otc-predictor-backend",
  "version": "1.0.0",
  "description": "OTC Predictor Backend API - Express server with MongoDB and Puppeteer screen capture",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:quotex": "node test_quotex_integration.js",
    "install-python": "python3 -m venv venv && source venv/bin/activate && pip install -r requirements.txt",
    "start-bridge": "source venv/bin/activate && python3 python_bridge/start_bridge.py",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "docker:build": "docker build -t otc-predictor-backend .",
    "docker:run": "docker run -p 5001:5001 --env-file .env otc-predictor-backend",
    "docker:test": "docker build -t otc-test . && docker run --rm otc-test npm test"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "brain.js": "^2.0.0-beta.23",
    "cloudinary": "^2.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mongoose": "^8.0.1",
    "puppeteer": "^21.5.2",
    "sharp": "^0.34.3",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "eslint": "^9.39.2",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.1.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "keywords": [
    "otc",
    "trading",
    "prediction",
    "puppeteer",
    "mongodb",
    "express",
    "api"
  ]
}
