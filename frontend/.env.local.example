# Copy this file to .env.local and adjust values
# These variables are read by Next.js at build time (restart dev server after changes)

# Public API base (HTTP/S). Example:
# NEXT_PUBLIC_API_URL=https://apigatewayfront-end-production.up.railway.app
# or for local dev:
# NEXT_PUBLIC_API_URL=http://localhost:5001
NEXT_PUBLIC_API_URL=

# Public WebSocket base (WS/WSS). Example:
# NEXT_PUBLIC_WS_URL=wss://apigatewayfront-end-production.up.railway.app
# or for local dev:
# NEXT_PUBLIC_WS_URL=ws://localhost:5001
NEXT_PUBLIC_WS_URL=

# Optional: direct ML training service base
# NEXT_PUBLIC_ML_TRAINING_URL=https://ml-traning-service-production.up.railway.app
# or local
# NEXT_PUBLIC_ML_TRAINING_URL=http://localhost:8002
NEXT_PUBLIC_ML_TRAINING_URL=
